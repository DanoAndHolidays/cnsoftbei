[{"id":"j051","moduleId":"module-1","type":"single","difficulty":"easy","tags":["syntax"],"question":"Java 程序的执行入口方法是？","options":["start()","main()","run()","init()"],"answer":"B","explanation":"public static void main(String[] args) 是 Java 固定入口方法。"},{"id":"j052","moduleId":"module-1","type":"single","difficulty":"easy","tags":["syntax"],"question":"Java 单行注释使用哪个符号？","options":["#","//","/*","--"],"answer":"B","explanation":"// 用于单行注释，/* */ 用于多行注释。"},{"id":"j053","moduleId":"module-1","type":"single","difficulty":"medium","tags":["syntax","errorPoint"],"question":"Java 用来划分代码块的符号是？","options":["()","[]","{}","<>"],"answer":"C","explanation":"大括号 {} 是 Java 划分代码块的标准符号。"},{"id":"j054","moduleId":"module-2","type":"single","difficulty":"easy","tags":["knowledgeBase"],"question":"以下不属于 Java 基本数据类型的是？","options":["int","String","char","boolean"],"answer":"B","explanation":"String 是引用类型，其余三项为基本数据类型。"},{"id":"j055","moduleId":"module-2","type":"single","difficulty":"medium","tags":["knowledgeBase","errorPoint"],"question":"布尔类型的取值个数是？","options":["1","2","3","4"],"answer":"B","explanation":"boolean 只有 true、false 两个取值。"},{"id":"j056","moduleId":"module-3","type":"single","difficulty":"easy","tags":["dataType"],"question":"Java 数组下标起始位置是？","options":["0","1","-1","随机"],"answer":"A","explanation":"数组下标从 0 开始，最大下标为 数组长度-1。"},{"id":"j057","moduleId":"module-3","type":"single","difficulty":"medium","tags":["dataType","errorPoint"],"question":"获取数组长度使用以下哪项？","options":["size()","length","getLength()","len()"],"answer":"B","explanation":"数组用 length 属性，集合用 size() 方法。"},{"id":"j058","moduleId":"module-4","type":"single","difficulty":"easy","tags":["operator"],"question":"判断两个基本类型数值是否相等使用？","options":["=","==","equals","==="],"answer":"B","explanation":"== 比较基本类型数值，= 是赋值运算符。"},{"id":"j059","moduleId":"module-4","type":"single","difficulty":"medium","tags":["operator","errorPoint"],"question":"具备短路效果的逻辑与运算符是？","options":["&","&&","|","||"],"answer":"B","explanation":"&& 短路与，|| 短路或，& 和 | 无短路特性。"},{"id":"j060","moduleId":"module-5","type":"single","difficulty":"easy","tags":["processControl"],"question":"跳出当前循环的语句是？","options":["continue","break","return","goto"],"answer":"B","explanation":"break 终止循环，continue 跳过本轮循环。"},{"id":"j061","moduleId":"module-5","type":"single","difficulty":"medium","tags":["processControl","errorPoint"],"question":"以下哪项不是循环语句？","options":["for","while","do...while","switch"],"answer":"D","explanation":"switch 是分支语句，不属于循环结构。"},{"id":"j062","moduleId":"module-6","type":"single","difficulty":"easy","tags":["function"],"question":"表示方法无返回值的关键字是？","options":["null","void","empty","none"],"answer":"B","explanation":"void 修饰无返回值方法。"},{"id":"j063","moduleId":"module-6","type":"single","difficulty":"medium","tags":["function","errorPoint"],"question":"方法重载的要求不包括？","options":["方法名相同","参数列表不同","返回值不同","参数类型不同"],"answer":"C","explanation":"重载与返回值无关，只看方法名和参数列表。"},{"id":"j064","moduleId":"module-7","type":"single","difficulty":"easy","tags":["scope"],"question":"定义在方法内部的变量称为？","options":["成员变量","局部变量","静态变量","全局变量"],"answer":"B","explanation":"方法内为局部变量，类中方法外为成员变量。"},{"id":"j065","moduleId":"module-7","type":"single","difficulty":"medium","tags":["scope","errorPoint"],"question":"局部变量默认初始值为？","options":["0","null","空","无默认值"],"answer":"D","explanation":"局部变量必须手动赋值，没有默认初始值。"},{"id":"j066","moduleId":"module-8","type":"single","difficulty":"easy","tags":["oop","classObj"],"question":"定义类使用的关键字是？","options":["class","struct","object","define"],"answer":"A","explanation":"class 是 Java 定义类的关键字。"},{"id":"j067","moduleId":"module-8","type":"single","difficulty":"medium","tags":["oop","classObj","errorPoint"],"question":"创建对象使用哪个关键字？","options":["create","new","instance","build"],"answer":"B","explanation":"new 关键字调用构造方法创建实例对象。"},{"id":"j068","moduleId":"module-9","type":"single","difficulty":"easy","tags":["oop","inherit"],"question":"实现类继承的关键字是？","options":["implements","extends","inherits","using"],"answer":"B","explanation":"extends 实现类继承，